# Per-Dockerfile excludes for trail-admin. Combined with repo-root
# .dockerignore (BuildKit reads both — additive).
#
# admin-server only imports @trail/shared. It does NOT need engine
# source, drizzle migrations, pipelines, etc. Excluding aggressively
# trims context from 7 MB → ~1 MB.

# Engine source — admin proxies to engine via HTTP, doesn't compile its code
apps/server

# admin SPA: we only need dist/ (built by ship script). Skip everything else.
apps/admin/src
apps/admin/public
apps/admin/index.html
apps/admin/vite.config.ts
apps/admin/tsconfig.json
apps/admin/package.json

# Trail packages admin-server doesn't import
packages/db
packages/pipelines
packages/storage
packages/sdk
packages/core

# NOTE: apps/admin/dist/ambient (7.8 MB .opus sounds) + dist/thinking
# (460 KB) are now INCLUDED in the deploy context. Christian wants
# trail-sound feature on prod. F173 (Tigris) is the long-term answer
# for static media; until then we eat the 8 MB context cost per deploy.
