{
  "manifest_version": 3,
  "name": "Trail Web Clipper",
  "version": "0.2.1",
  "description": "Clip any web page straight into your Trail knowledge base — one click, on the page you are already reading.",
  "icons": {
    "16": "icons/icon16-dark.png",
    "48": "icons/icon48-dark.png",
    "128": "icons/icon128-dark.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-dark.png",
      "48": "icons/icon48-dark.png",
      "128": "icons/icon128-dark.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.trailmem.com/*",
    "http://127.0.0.1:58031/*"
  ],
  "background": {
    "service_worker": "src/background/main.ts",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trail-clipper@broberg.ai",
      "strict_min_version": "109.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/extractor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
